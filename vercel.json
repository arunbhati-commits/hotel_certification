{
  "builds": [
    {
      "src": "api/upload_folder.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["audit_ui_server.py", "validate_hotel_test_cases.py"] }
    },
    { "src": "audit_ui/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/upload_folder", "dest": "/api/upload_folder.py" },
    { "src": "/", "dest": "/audit_ui/index.html" },
    { "src": "/(styles\\.css|app\\.js)", "dest": "/audit_ui/$1" },
    { "src": "/sample/(.*)", "dest": "/audit_ui/sample/$1" }
  ]
}
